{
  "name": "rag_prefix",
  "description": "RAG/共享前缀场景：多组请求共享长 system prompt，验证 prefix cache 命中率收益",
  "backend": "sglang-oai",
  "model": "Qwen/Qwen2.5-0.5B-Instruct",
  "dataset_name": "generated-shared-prefix",
  "stages": [
    {
      "label": "gsp-8rps",
      "request_rate": 8,
      "num_prompts": 240,
      "input_len": 512,
      "output_len": 128,
      "extra_args": "--gsp-num-groups 16 --gsp-prompts-per-group 15 --gsp-system-prompt-len 2048 --gsp-question-len 128 --gsp-output-len 128"
    }
  ],
  "slo": {
    "ttft_p99_ms": 500,
    "tpot_p99_ms": 100,
    "e2e_p99_ms": 10000,
    "min_success_rate": 0.999
  }
}
